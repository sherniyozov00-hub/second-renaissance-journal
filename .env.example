# Copy to .env and fill in. NEVER commit .env — only this file lists the names.
# Values marked [..] are provided by the customer later (TZ section 19).

# ── Site ─────────────────────────────────────────────────────────────────────
SITE_NAME="The Second Renaissance of Uzbekistan"
SITE_WORDMARK="The Second Renaissance"
SITE_WORDMARK_SUB="OF UZBEKISTAN"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production only (docker-compose.prod.yml): the domain Caddy gets an HTTPS certificate for.
DOMAIN=

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
# Local dev (npm run dev) against the compose Postgres:
DATABASE_URL="postgresql://journal:journal@localhost:5432/journal?schema=public"
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal
POSTGRES_DB=journal

# ── Redis (background jobs) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── File storage (S3-compatible; MinIO locally) ─────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=journal
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ── Seed ─────────────────────────────────────────────────────────────────────
SEED_ON_START=true
# false on a real server: no demo accounts and sample articles (docs/deploy.md).
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PHONE=+998900000001

# ── Auth ─────────────────────────────────────────────────────────────────────
# Long random string: `openssl rand -base64 32`. Required in production.
AUTH_SECRET=
# Google sign-in appears only when both are set.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# SMS provider: mock (codes are written to the app log) or eskiz.
SMS_PROVIDER=mock
SMS_ESKIZ_EMAIL=
SMS_ESKIZ_PASSWORD=
SMS_ESKIZ_FROM=4546
# Mock mode only: fixed login code for demos and e2e tests. Ignored once a real
# SMS/email provider is configured. Leave empty in production.
OTP_MOCK_CODE=

# ── Email / Telegram (stage 5) ───────────────────────────────────────────────
EMAIL_FROM=
SMTP_URL=
RESEND_API_KEY=
TELEGRAM_BOT_TOKEN=
# Random string; also passed to setWebhook as secret_token (see README).
TELEGRAM_WEBHOOK_SECRET=

# ── Background jobs (PDF, notifications) ────────────────────────────────────
# queue (default): the `worker` service runs them. inline: run inside the web
# request — for local development without the worker.
JOBS_MODE=queue
# URL the worker uses to reach the web app when printing PDFs.
APP_INTERNAL_URL=http://localhost:3000

# ── Payments (stage 4) — sandbox until real keys are provided ───────────────
# sandbox: our own test checkout page, no money moves. live: real providers.
PAYMENTS_MODE=sandbox
# Click SHOP API. Callbacks: https://<domain>/api/payments/click/prepare and /complete
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
# Payme Merchant API. Endpoint: https://<domain>/api/payments/payme
# Test cashbox: PAYME_CHECKOUT_URL=https://checkout.test.paycom.uz
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Uzum Bank: adapter is waiting for the merchant's API contract (see docs/decisions.md).
UZUM_MERCHANT_ID=
UZUM_SECRET_KEY=

# ── Xorazmiy AI (stage 6) — server-side only ─────────────────────────────────
# Claude API key. Without it every AI feature runs an offline mock ("sinov rejimi").
ANTHROPIC_API_KEY=
# Force the mock even with a key: AI_MODE=mock (tests, demos).
AI_MODE=
# OpenAlex / Crossref / Semantic Scholar are called directly; SCHOLAR_MODE=mock
# serves fixtures where outbound network is blocked (CI, sandboxes).
SCHOLAR_MODE=
